<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ===== MAIN CONTENT ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/window_background"
        android:orientation="vertical">

        <!-- ===== AppBar + Toolbar ===== -->
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/window_background"
            app:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/window_background"
                app:navigationIcon="@drawable/ic_nav_configs"
                app:navigationIconTint="@color/toolbar_icon"
                app:title="VPN Manager"
                app:titleTextColor="@color/toolbar_title" />
        </com.google.android.material.appbar.AppBarLayout>

        <!-- แท็บ MAIN / CHART / LOG — สไตล์เดิม สีเขียว -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/window_background"
            app:tabGravity="fill"
            app:tabMode="fixed"
            app:tabIndicatorColor="@color/accent_green"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorHeight="2dp"
            app:tabSelectedTextColor="@color/accent_green"
            app:tabTextColor="@color/tab_unselected"
            app:tabRippleColor="@color/accent_green" />

        <!-- ⭐ ===== ViewPager2 — ปัดซ้าย-ขวาได้ ===== -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- ===== Bottom Nav + FAB (เชื่อมต่อ) ===== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@color/bottom_nav_background">

            <!-- แถบเมนู -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_bottom_nav"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="6dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:id="@+id/actionHome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_nav_home"
                        app:tint="@color/bottom_nav_icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Home"
                        android:textColor="@color/bottom_nav_icon"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/actionChart"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_nav_chart"
                        app:tint="@color/bottom_nav_icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="CHART"
                        android:textColor="@color/bottom_nav_icon"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- ช่องว่างกลางให้ FAB -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1.15" />

                <LinearLayout
                    android:id="@+id/actionLog"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_nav_log"
                        app:tint="@color/bottom_nav_icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Log"
                        android:textColor="@color/bottom_nav_icon"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/actionAdd"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_nav_configs"
                        app:tint="@color/bottom_nav_icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="CONFIGS"
                        android:textColor="@color/bottom_nav_icon"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- FAB เชื่อมต่อ กลางล่าง -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabConnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="18dp"
                android:contentDescription="เชื่อมต่อ / ตัดการเชื่อมต่อ"
                android:src="@android:drawable/ic_lock_power_off"
                app:backgroundTint="#6B7280"
                app:borderWidth="0dp"
                app:elevation="8dp"
                app:fabCustomSize="58dp"
                app:maxImageSize="28dp"
                app:tint="#FFFFFF" />
        </FrameLayout>

    </LinearLayout>

    <!-- ===== NAVIGATION DRAWER ===== -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/drawer_background"
        app:headerLayout="@layout/nav_header_connection"
        app:itemIconTint="@color/drawer_item"
        app:itemTextColor="@color/drawer_item"
        app:menu="@menu/menu_drawer_connection" />

</androidx.drawerlayout.widget.DrawerLayout>
