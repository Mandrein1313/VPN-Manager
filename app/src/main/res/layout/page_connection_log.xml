<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scrollLogView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#111111"
        android:paddingTop="52dp"
        android:paddingHorizontal="8dp">

        <TextView
            android:id="@+id/txtLogContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#DDDDDD"
            android:textIsSelectable="true"
            android:textSize="10sp" />
    </ScrollView>

    <!-- ⭐ Toolbar ของ LOG -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#0D1117"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:letterSpacing="0.15"
            android:text="LOG"
            android:textColor="#888888"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnLogCopy"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="คัดลอก"
            android:focusable="true"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_save"
            app:tint="#B0BEC5" />

        <ImageButton
            android:id="@+id/btnLogClear"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="ล้าง log"
            android:focusable="true"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="#EF5350" />

        <ImageButton
            android:id="@+id/btnLogScrollBottom"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="ล่างสุด"
            android:focusable="true"
            android:padding="8dp"
            android:src="@android:drawable/arrow_down_float"
            app:tint="#00E676" />
    </LinearLayout>
</FrameLayout>
