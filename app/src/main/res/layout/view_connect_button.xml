<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout">

    <!-- วงนอกสุด -->
    <View
        android:id="@+id/ringOuter"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_connect_ring_outer"
        android:clickable="false"
        android:focusable="false" />

    <!-- วงกลาง -->
    <View
        android:id="@+id/ringMiddle"
        android:layout_width="210dp"
        android:layout_height="210dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_connect_ring_middle"
        android:clickable="false"
        android:focusable="false" />

    <!-- วงใน = ปุ่มกด — ตัดขอบให้เป็นวงกลม ไม่ให้โชว์สี่เหลี่ยมตอนกด -->
    <FrameLayout
        android:id="@+id/circleInner"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_connect_circle_idle"
        android:clickable="true"
        android:focusable="true"
        android:clipToOutline="true"
        android:outlineProvider="background"
        android:foreground="@null"
        android:stateListAnimator="@null">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="false"
            android:focusable="false">

            <ImageView
                android:id="@+id/iconPower"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_power"
                android:contentDescription="Connect"
                android:clickable="false"
                android:focusable="false" />

            <TextView
                android:id="@+id/txtButtonLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="เชื่อมต่อ"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>
    </FrameLayout>
</merge>
